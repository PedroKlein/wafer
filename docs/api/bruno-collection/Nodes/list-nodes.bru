meta {
  name: List All Nodes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/nodes
  body: none
  auth: none
}

docs {
  Returns id, state, processed, failed, and replacement_eligible for each node.
  replacement_eligible is true only for a loaded Wasm Transform, Filter, or Router.
}

assert {
  res.status: eq 200
  res.body: isArray
}
