package pipeline:transform@0.1.0;

interface router {
    use types.{envelope, process-error, port-id};

    /// Result of routing a message
    record route-result {
        /// Target output port
        port: port-id,
        /// Message to emit (may be transformed)
        envelope: envelope,
    }

    /// Get the list of available output ports
    ///
    /// Called during pipeline initialization to wire up downstream connections.
    /// The returned port IDs must be stable for the lifetime of the node.
    output-ports: func() -> list<port-id>;

    /// Route an input message to an output port
    ///
    /// Returns:
    /// - ok(route-result): Message routed to specified port
    /// - err(process-error): Routing failed
    route: func(input: envelope) -> result<route-result, process-error>;
}

/// Router node world - implements lifecycle + router
world router-node {
    /// Export lifecycle (validate, init, close)
    export lifecycle;

    /// Export router-specific interface
    export router;
}
