meta {
  name: Shutdown Pipeline
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/pipeline/shutdown
  body: none
  auth: none
}

docs {
  Signals cancellation of every node task and returns 200. Cleanup is
  cooperative and bounded by a 5 s shutdown deadline; the response does not
  prove every in-flight message reached a sink. Watch the process exit.
}

assert {
  res.status: eq 200
}
