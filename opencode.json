{
  "$schema": "https://opencode.ai/config.json",
  "model": "sap-ai-core/anthropic--claude-4.5-opus",
  "theme": "flexoki",
  "plugin": ["opencode-beads"],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "zotero": {
      "type": "local",
      "command": ["zotero-mcp", "serve"],
      "environment": {
        "ZOTERO_LOCAL": "true"
      },
      "enabled": true
    }
  },

  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "bd *": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "cargo publish*": "ask"
    },
    "external_directory": "ask"
  }
}
