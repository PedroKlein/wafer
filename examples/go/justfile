# Build all Go plugins
build-go: build-math-plugin

# Build the Go math plugin using TinyGo
build-math-plugin:
    @echo "Building Go math plugin with TinyGo..."
    @cd math_plugin && \
    tinygo build -o math_plugin.wasm -target wasm -no-debug -opt=2 ./main.go && \
    echo "Copying WASM file to plugins directory..." && \
    cp math_plugin.wasm ../../../plugins/go_math_plugin.wasm && \
    echo "Go math plugin built successfully!"

# Check Go code formatting
check:
    @cd math_plugin && go vet ./...

# Format Go code
fmt:
    @cd math_plugin && go fmt ./...

# Clean build artifacts
clean:
    @cd math_plugin && rm -f *.wasm

# Optimize the WASM file (requires wasm-opt from binaryen)
optimize:
    @echo "Optimizing WASM file..."
    @cd math_plugin && \
    if command -v wasm-opt >/dev/null 2>&1; then \
        wasm-opt -O3 -o math_plugin_optimized.wasm math_plugin.wasm && \
        cp math_plugin_optimized.wasm ../../../plugins/go_math_plugin.wasm && \
        echo "Optimized WASM file copied to plugins directory"; \
    else \
        echo "wasm-opt not found. Install binaryen for optimization."; \
    fi
