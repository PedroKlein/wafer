// wafer:pipeline — self-contained WIT for the TinyGo uppercase plugin.
//
// This is a full copy of the wafer:pipeline package (types, logging,
// lifecycle, transform, filter) plus the transform-node-go world variant
// that includes wasi:cli/imports. TinyGo's build tooling cannot reach into
// the workspace-root wit/ directory, so this plugin ships its own copy.
//
// Keep in sync with ../../../wit/pipeline-*.wit and ../../../wit/worlds.wit.

package wafer:pipeline@0.1.0;

// -------------------------------------------------------------------------
// Types
// -------------------------------------------------------------------------

interface types {
    resource buffer {
        size: func() -> u64;
        read: func(offset: u64, len: u64) -> list<u8>;
        read-all: func() -> list<u8>;
    }

    record message {
        id: string,
        timestamp: u64,
        source: string,
        content-type: string,
        metadata: list<tuple<string, string>>,
        payload: borrow<buffer>,
    }

    record output-message {
        id: string,
        timestamp: u64,
        source: string,
        content-type: string,
        metadata: list<tuple<string, string>>,
        payload: list<u8>,
    }

    variant process-error {
        bad-input(string),
        dependency-failed(string),
        processing-failed(string),
        timed-out,
        unrecoverable(string),
    }

    type port-id = string;

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }
}

// -------------------------------------------------------------------------
// Logging
// -------------------------------------------------------------------------

interface logging {
    use types.{log-level};

    log: func(level: log-level, message: string);
}

// -------------------------------------------------------------------------
// Lifecycle
// -------------------------------------------------------------------------

interface lifecycle {
    use types.{process-error};

    record node-config {
        id: string,
        config: string,
        plugin-version: string,
    }

    validate: func(config: node-config) -> option<string>;
    init: func(config: node-config) -> result<_, process-error>;
    close: func();
}

// -------------------------------------------------------------------------
// Transform
// -------------------------------------------------------------------------

interface transform {
    use types.{message, output-message, process-error};

    process: func(input: message) -> result<output-message, process-error>;
}

// -------------------------------------------------------------------------
// Worlds
// -------------------------------------------------------------------------

// Transform world for TinyGo — same shape as transform-node in the canonical
// wafer:pipeline, plus the wasi:cli/imports include that TinyGo needs at
// runtime. The host satisfies these imports; the plugin never calls them
// directly.
world transform-node-go {
    import types;
    import logging;
    include wasi:cli/imports@0.2.0;
    export lifecycle;
    export transform;
}
