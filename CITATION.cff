    affiliation: "Universidade Federal do Rio Grande do Sul (UFRGS)"
repository-code: "https://github.com/PedroKlein/wafer"
license: MIT
keywords:
  - WebAssembly
  - Component Model
  - edge computing
  - IoT
  - stream processing
  - pipeline runtime
