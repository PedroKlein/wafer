interface types {
    type message-id = string;
    type timestamp = u64;
    type port-id = string;
    type metadata = list<tuple<string, string>>;

    variant payload {
        raw(list<u8>),
    }

    record envelope {
        id: message-id,
        timestamp: timestamp,
        source: string,
        metadata: metadata,
        payload: payload,
    }

    variant process-result {
        emit(envelope),
        filter,
        error(process-error),
    }

    record process-error {
        code: string,
        message: string,
        retriable: bool,
    }
}
