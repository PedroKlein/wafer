/// Shared type definitions for all node types
///
/// This interface contains common types used across Source, Transform,
/// Router, Joiner, and Sink nodes.
interface types {
    /// Unique identifier for messages
    type message-id = string;

    /// Unix timestamp in nanoseconds
    type timestamp = u64;

    /// Port identifier for routing (used by Router/Joiner nodes)
    type port-id = string;

    /// Generic key-value metadata
    /// Using list of tuples for WIT compatibility (maps not directly supported)
    type metadata = list<tuple<string, string>>;

    // ========================================================================
    // Payload Types
    // ========================================================================

    /// Payload variants - extensible for different data types
    ///
    /// Design note: Start with `raw` only for MVP. Future variants:
    /// - json(json-value) - Parsed JSON
    /// - sensor-reading(sensor-reading) - Typed sensor data
    /// - tensor(tensor) - ML tensor data
    /// - image(image-data) - Image with format metadata
    variant payload {
        /// Raw bytes (unparsed) - use when format is unknown or binary
        raw(list<u8>),
    }

    // ========================================================================
    // Message Envelope
    // ========================================================================

    /// Standard message envelope - wraps all data flowing through the pipeline
    ///
    /// Design rationale:
    /// - `id`: Enables deduplication, tracing, and acknowledgment
    /// - `timestamp`: Processing time (when message entered pipeline)
    /// - `source`: Origin identifier for debugging and routing
    /// - `metadata`: Extensible key-value pairs for custom attributes
    /// - `payload`: The actual data, typed via payload variant
    record envelope {
        /// Unique message identifier (UUID v4 recommended)
        id: message-id,
        /// Processing timestamp (nanoseconds since Unix epoch)
        timestamp: timestamp,
        /// Source identifier (e.g., MQTT topic, node ID)
        source: string,
        /// Extensible metadata as key-value pairs
        metadata: metadata,
        /// Message payload
        payload: payload,
    }

    // ========================================================================
    // Processing Results
    // ========================================================================

    /// Result of processing a message
    variant process-result {
        /// Successfully processed, emit envelope to output
        emit(envelope),
        /// Message filtered out, do not emit (not an error)
        filter,
        /// Processing error, route to error handling
        error(process-error),
    }

    /// Error information from node processing
    record process-error {
        /// Error code for programmatic handling (e.g., "PARSE_FAILED", "TIMEOUT")
        code: string,
        /// Human-readable error message
        message: string,
        /// Whether this error is retriable
        retriable: bool,
    }
}
