meta {
  name: Get Node Details
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/nodes/{{nodeId}}
  body: none
  auth: none
}

vars:pre-request {
  nodeId: transform
}

docs {
  Returns id, state, processed, failed, and replacement_eligible for one node.
  Change nodeId to query another configured node. Returns 404 when absent.
}

assert {
  res.status: in [200, 404]
}
