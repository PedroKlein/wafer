/// pipeline:inference - Interface for inference nodes with wasi-nn
///
/// Inference nodes combine standard transform capabilities with ML inference
/// via wasi-nn. They receive messages, perform inference, and emit results.
///
/// ## Usage
///
/// An inference node implements the same lifecycle and transform interfaces
/// as a transform-node, but has access to wasi-nn for loading models and
/// running inference.
///
/// ## wasi-nn Interfaces
///
/// The host runtime provides these wasi-nn interfaces:
/// - wasi:nn/graph - Model loading and graph management
/// - wasi:nn/tensor - Tensor creation and manipulation
/// - wasi:nn/inference - Running inference on loaded models
/// - wasi:nn/errors - Error types for ML operations
package pipeline:inference@0.1.0;

/// Inference node world - extends transform-node with wasi-nn imports
///
/// This world includes all transform-node capabilities (lifecycle, transform)
/// plus imports for wasi-nn interfaces to enable ML inference.
world inference-node {
    /// Export lifecycle (validate, init, close)
    export lifecycle;

    /// Export transform-specific interface
    export transform;

    /// Import wasi-nn interfaces for ML inference
    /// Note: These are provided by the host runtime (e.g., wasmtime with wasi-nn)
    ///
    /// Available interfaces:
    /// - graph: Load ML models (ONNX, TensorFlow, etc.)
    /// - tensor: Create and manipulate tensors
    /// - inference: Execute inference on loaded models
    /// - errors: Handle ML-specific errors
    ///
    /// Example usage in component:
    ///   let graph = wasi::nn::graph::load(...);
    ///   let context = graph.init_execution_context();
    ///   context.set_input(tensor);
    ///   context.compute();
    ///   let output = context.get_output();
    import wasi:nn/graph;
    import wasi:nn/tensor;
    import wasi:nn/inference;
    import wasi:nn/errors;
}
