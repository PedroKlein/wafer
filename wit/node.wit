package pipeline:node@0.1.0;

/// Node lifecycle interface
interface lifecycle {
    use pipeline:types/types.{metadata-entry};
    
    /// Node configuration passed during initialization
    record node-config {
        /// Node name
        name: string,
        /// Node-specific configuration entries
        config: list<metadata-entry>,
    }
    
    /// Initialize the node with configuration
    /// Called once before any processing
    init: func(config: node-config) -> result<_, string>;
}
