package wafer:pipeline@0.1.0;

// wafer:pipeline — worlds for the three WAFER node roles.
//
// Guest plugins pick the world that matches what they export:
//   - transform-node: lifecycle + transform
//   - filter-node:    lifecycle + filter
//   - router-node:    lifecycle + router
//
// All imports (types, logging) are same-package interfaces.


// A standard transform node: exports lifecycle + transform.
world transform-node {
    import types;
    import logging;
    export lifecycle;
    export transform;
}

// A filter node: exports lifecycle + filter.
world filter-node {
    import types;
    import logging;
    export lifecycle;
    export filter;
}

// A router node: exports lifecycle + router.
world router-node {
    import types;
    import logging;
    export lifecycle;
    export router;
}

// A transform with an explicitly granted wasi-nn capability.
world inference-node {
    import types;
    import logging;
    import wasi:nn/tensor@0.2.0-rc-2024-10-28;
    import wasi:nn/graph@0.2.0-rc-2024-10-28;
    import wasi:nn/inference@0.2.0-rc-2024-10-28;
    import wasi:nn/errors@0.2.0-rc-2024-10-28;
    export lifecycle;
    export transform;
}
