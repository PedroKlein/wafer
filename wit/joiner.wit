package pipeline:transform@0.1.0;

interface joiner {
    use types.{envelope, process-result, port-id};

    /// Return list of input port identifiers this joiner accepts
    ///
    /// Called during initialization to configure upstream connections.
    /// Each input port can receive messages from a different source.
    input-ports: func() -> list<port-id>;

    /// Process a message from a specific input port
    ///
    /// Returns:
    /// - emit(envelope): Pass message downstream
    /// - filter: Message filtered out (not an error, just dropped)
    /// - error(e): Processing failed, route to error handling
    process: func(port: port-id, input: envelope) -> process-result;
}

/// Joiner node world - implements lifecycle + joiner
world joiner-node {
    /// Export lifecycle (validate, init, close)
    export lifecycle;

    /// Export joiner-specific interface
    export joiner;
}
