meta {
  name: Get Prometheus Metrics
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/metrics
  body: none
  auth: none
}

docs {
  Returns metrics in Prometheus text format for scraping. Current families
  (see docs/operations/observability.md for the full table):
  - wafer_node_processed_total{node}
  - wafer_node_failed_total{node}, wafer_node_filtered_out_total{node},
    wafer_node_retries_total{node}, wafer_node_skipped_total{node},
    wafer_node_retry_exhausted_skip_total{node}
  - wafer_node_dlq_sent_total{node}, wafer_node_dlq_lost_total{node}
  - wafer_node_dropped_on_recovery_total{node},
    wafer_node_dropped_on_teardown_total{node}
  - wafer_node_traps_total{node,kind}, wafer_node_guest_errors_total{node,category}
  - hot_swap_phase_ns_{bucket,sum,count}{phase,node_id}
  - wafer_node_recovery_duration_ms_*{node_id}
  
  **Note:** By default /metrics is served on the API listener (baseUrl).
  Only when the runtime is started with --metrics-bind <ADDR> is it served
  on that separate listener; then change the URL to {{metricsUrl}} and set
  metricsUrl to match that address.
}

assert {
  res.status: eq 200
}
