meta {
  name: Readiness Check
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ready
  body: none
  auth: none
}

docs {
  Readiness check endpoint.
  
  Returns OK if the pipeline is ready to process messages.
  Use this for Kubernetes readiness probes.
  
  Returns 503 Service Unavailable with {"ready": false, "reason": "not running"}
  once the pipeline is no longer running (for example after shutdown was
  signalled).
}

assert {
  res.status: in [200, 503]
  res.body.ready: isDefined
}
