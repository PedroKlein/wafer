# WAFER — .gitignore

# Rust build artifacts
/target/
/build/
/dist/
target/docker-aarch64-linux/

# WebAssembly artifacts (built plugins)
*.wasm

# Native library artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test / coverage artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.venv-eval/
eval/analysis/.venv/

# Notebook checkpoints
.ipynb_checkpoints/

# IDE / editor
.idea/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs / temporary files
*.log
logs/
dlq.jsonl
*.tmp
*.temp
.tmp/
.temp/

# Backup / archive
*.bak
*.backup
*.tar.gz
*.zip
*.rar

# Documentation build
site/
docs/_build/

# Debug / profiling
debug
*.debug
*.prof
*.pprof

# Security material
*.pem
*.key
*.crt
*.p12

# Agent / plan scratch (any local agent runner state)
/.pi
/.pi-*
/.plans/
/.tasks
/.a5c
/.cache-dir
/.claude/*
!/.claude/settings.json
!/.claude/skills
/.cursor
/.aider*
.plan-verify/


# Local vector store (agent memory / embeddings)
.chroma_db/

# eval/ result trees — large generated artifacts.
eval/results/*/

# Notebook outputs (mise run //eval:figures); thesis copies live in tcc-doc
eval/analysis/figures/
