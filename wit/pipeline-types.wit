package wafer:pipeline@0.1.0;

// wafer:pipeline — shared data types for the WAFER pipeline runtime.
//
// This interface contains the buffer resource and message types that cross
// the Wasm boundary on every pipeline call.
//
// Design decisions:
//   - buffer is a host-managed resource; only methods that are called actually
//     transfer bytes, enabling router/filter to skip payload entirely.
//   - message uses borrow<buffer> (input, read-on-demand).
//   - output-message uses list<u8> (output, component-owned bytes).
//   - process-error categories map to the host error policy engine.
//
// All wafer:pipeline interfaces live in one package; there are no cross-package
// dependencies inside this repo. See docs/rfcs/RFC-001-wit-contracts.md.


interface types {
    // -------------------------------------------------------------------------
    // Buffer resource — host-managed payload container.
    //
    // Input payloads live in host memory. Components read bytes on demand via
    // these methods. Router and filter plugins never need to call read() at all,
    // so the payload is never copied for routing. The message header strings
    // below are still copied into the guest on every call.
    // -------------------------------------------------------------------------

    resource buffer {
        // Returns the total byte length of the payload.
        size: func() -> u64;

        // Reads a slice of the payload. Returns fewer bytes if offset+len exceeds size.
        read: func(offset: u64, len: u64) -> list<u8>;

        // Reads the entire payload in one call.
        read-all: func() -> list<u8>;
    }

    // -------------------------------------------------------------------------
    // Message types
    // -------------------------------------------------------------------------

    // Inbound message — payload is a borrow handle into host memory.
    record message {
        id: string,
        timestamp: u64,           // nanoseconds since Unix epoch
        source: string,
        content-type: string,
        metadata: list<tuple<string, string>>,
        payload: borrow<buffer>,  // host-managed, read on demand
    }

    // Outbound message — component provides the payload bytes directly.
    record output-message {
        id: string,
        timestamp: u64,
        source: string,
        content-type: string,
        metadata: list<tuple<string, string>>,
        payload: list<u8>,
    }

    // -------------------------------------------------------------------------
    // Error types
    // -------------------------------------------------------------------------

    // Five-category error variant. The host's error policy engine dispatches each
    // category to the configured action (retry, DLQ, skip, teardown). The
    // defaults below apply when [error_policy] does not override them. A DLQ
    // action without a [dead_letter] sink drops the message and counts it as
    // dlq_lost.
    variant process-error {
        // Malformed or schema-invalid input. Never retried; default action DLQ.
        bad-input(string),

        // External dependency (HTTP API, remote DB) is unavailable. Retryable.
        dependency-failed(string),

        // Internal plugin logic failed. Retryable up to the configured limit.
        processing-failed(string),

        // Plugin gave up on a deadline of its own. The host applies its timed-out
        // action and keeps the instance. Epoch interruption and fuel exhaustion get
        // the same action, but the host also replaces the trapped instance.
        timed-out,

        // Plugin state is beyond repair. The host re-instantiates the node, as it
        // does after a trap (panic, out-of-bounds access).
        unrecoverable(string),
    }

    // Logical port identifier — used in router output declarations and edge config.
    type port-id = string;

    // -------------------------------------------------------------------------
    // Host logging level
    // -------------------------------------------------------------------------

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }
}
