# Wafer POC - .gitignore

# Go binaries and executables
bin/*
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace and modules
go.work
go.work.sum
/vendor/

# WebAssembly files (generated plugins)
*.wasm
!plugins/example.wasm  # Keep the hand-written example

# Build and package directories
/target/
/build/
/dist/

# Rust build artifacts
examples/rust/*/target/
examples/rust/*/pkg/
examples/rust/*/Cargo.lock

# TinyGo/Go build artifacts
examples/go/*/pkg/
examples/go/*/*.wasm

# Node.js (for future JS/TS examples)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
*.tgz
.yarn-integrity

# Python (for future Python examples)
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.idea/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment and configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
.tmp/
.temp/

# Backup and archive files
*.bak
*.backup
*.tar.gz
*.zip
*.rar

# Documentation build
site/
docs/_build/

# Debug and profiling
debug
*.debug
*.prof
*.pprof

# Security files
*.pem
*.key
*.crt
*.p12


# Added by cargo

/target

# MQTT broker runtime data and logs
mqtt/data/
mqtt/log/

docker-compose.override.yml

/.delegation-runner
/.pi
/.a5c
.plan-verify/

# eval/results/ — experiment artifacts. Individual result dirs are large
# and generated. Commit only fixture-style examples that are explicitly
# `git add -f`'d for documentation purposes.
eval/results/*/
!eval/results/e-density-1/
.venv-eval/
