meta {
  name: Hot-Swap Node
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/nodes/{{nodeId}}/hot-swap
  body: json
  auth: none
}

body:json {
  {
    "wasm_path": "{{wasmPath}}"
  }
}

vars:pre-request {
  nodeId: transform
  wasmPath: plugins/pass-through/target/wasm32-wasip2/release/wafer_pass_through.wasm
}

docs {
  Replaces an eligible loaded Wasm Transform, Filter, or Router between messages.
  A successful response reports replacement_adopted and the first runner-local
  outcome. It does not prove sink convergence. A Transform can instead report
  status=rolled_back when its process-time canary traps. The response also
  carries compile_cache (compiled, memory_hit or disk_hit). A 202 means no
  runner-local outcome arrived within five seconds.
}

assert {
  res.status: in [200, 202, 400, 404, 409, 500, 504]
}
