meta {
  name: Shutdown Pipeline
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/pipeline/shutdown
  body: none
  auth: none
}

docs {
  Graceful shutdown — cancels the pipeline supervisor. In-flight messages
  complete their current node call before the task exits.
}

assert {
  res.status: in [200, 500]
}
