meta {
  name: Reconfigure Node
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/nodes/{{nodeId}}/reconfigure
  body: json
  auth: none
}

body:json {
  {
    "config": {
      "threshold": 42
    }
  }
}

vars:pre-request {
  nodeId: passthrough
}

docs {
  Re-instantiates an eligible loaded Wasm node from its cached component with
  new JSON configuration. The optional expected_plugin_hash field is compared
  with the SHA-256 of the plugin loaded on the node (recorded at launch and on
  every hot-swap); a mismatch returns 409. compile_ns, instantiate_ns and
  signal_ns are always null, and there is no compile_cache.
}

assert {
  res.status: in [200, 202, 400, 404, 409, 500, 504]
}
